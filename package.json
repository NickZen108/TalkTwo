{
  "name": "talktwo",
  "version": "0.4.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "layout:check": "node scripts/check-layout-safety.mjs",
    "privacy:check": "node scripts/check-privacy-surface.mjs",
    "qa": "npm run typecheck && npm run typecheck:tests && npm test && npm run layout:check && npm run privacy:check && npx expo-doctor && npm run audit:runtime"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}