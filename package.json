{
  "name": "talktwo",
  "version": "0.4.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:init": "npx eas-cli init",
    "build:android:apk": "npx eas-cli build --platform android --profile preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "layout:check": "node scripts/check-layout-safety.mjs",
    "privacy:check": "node scripts/check-privacy-surface.mjs",
    "ios:check": "node scripts/check-ios-surface.mjs",
    "handover:check": "node scripts/check-handover-readiness.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "qa": "npm run typecheck && npm run typecheck:tests && npm test && npm run layout:check && npm run privacy:check && npm run handover:check && npx expo-doctor && npm run audit:runtime"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.13",
    "expo-build-properties": "~57.0.12",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-iap": "^5.3.0",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.13",
    "expo-print": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.13",
    "expo-sqlite": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
